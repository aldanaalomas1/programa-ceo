        "payment_icons_ch271": {
          "type": "liquid",
          "settings": {
            "display_on_card": false,
            "liquid": "{%- comment -%} Formas de pago debajo del botón de compra {%- endcomment -%}\n<style>\n  .ch-pay { margin-top: 12px; margin-bottom: 22px; }\n  .ch-pay__label { display:block; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--color-scheme-text); opacity:.85; margin-bottom:8px; }\n  .ch-pay__list { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin:0; padding:0; list-style:none; }\n  .ch-pay__list li { display:block; line-height:0; }\n  .ch-pay__list svg { width:38px; height:24px; display:block; border-radius:4px; }\n  .ch-pay__badge { display:inline-flex; align-items:center; justify-content:center; height:24px; min-width:38px; padding:0 8px; border-radius:4px; font-family:-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",Arial,sans-serif; font-size:10px; font-weight:700; line-height:1; letter-spacing:.01em; white-space:nowrap; box-shadow:0 0 0 1px rgba(0,0,0,.08) inset; }\n  .ch-pay__logo { display:inline-flex; align-items:center; height:24px; padding:0 6px; border-radius:4px; background:#fff; box-shadow:0 0 0 1px rgba(0,0,0,.08) inset; }\n  .ch-pay__logo img { height:18px; width:auto; display:block; }\n  .ch-pay__badge--mp { background:#009ee3; color:#fff; }\n  .ch-pay__badge--alt { background:var(--color-scheme-accent-2); color:var(--color-scheme-accent-2-contrast); }\n</style>\n<div class=\"ch-pay\">\n  <span class=\"ch-pay__label font-heading\">Paga con</span>\n  <ul class=\"ch-pay__list\" aria-label=\"Formas de pago\">\n    {%- assign types = shop.enabled_payment_types -%}\n    {%- if types.size == 0 -%}\n      {%- assign types = 'visa,master,american_express,paypal,apple_pay,google_pay' | split: ',' -%}\n    {%- endif -%}\n    {%- for type in types -%}\n      <li>{{ type | payment_type_svg_tag: class: 'ch-pay__icon' }}</li>\n    {%- endfor -%}\n    {%- comment -%} Logos subidos en Contenido > Archivos: mercado-pago.png y kueski-pay.png. Si no existen, se muestra un badge de texto. {%- endcomment -%}\n    {%- assign mp_logo = images['mercado-pago.png'] -%}\n    {%- assign kueski_logo = images['kueski-pay.png'] -%}\n    {%- unless types contains 'mercado_pago' -%}\n      {%- if mp_logo.src -%}<li><span class=\"ch-pay__logo\"><img src=\"{{ mp_logo | image_url: height: 48 }}\" alt=\"Mercado Pago\" height=\"24\" loading=\"lazy\"></span></li>\n      {%- else -%}<li><span class=\"ch-pay__badge ch-pay__badge--mp\">mercado pago</span></li>{%- endif -%}\n    {%- endunless -%}\n    {%- unless types contains 'kueski' -%}\n      {%- if kueski_logo.src -%}<li><span class=\"ch-pay__logo\"><img src=\"{{ kueski_logo | image_url: height: 48 }}\" alt=\"Kueski Pay\" height=\"24\" loading=\"lazy\"></span></li>\n      {%- else -%}<li><span class=\"ch-pay__badge ch-pay__badge--alt\">Kueski Pay</span></li>{%- endif -%}\n    {%- endunless -%}\n  </ul>\n</div>\n"
          }
        },
        "pack_cards_ch271": {
          "type": "liquid",
          "settings": {
            "display_on_card": false,
            "liquid": "{%- comment -%} Selector de packs estilo tarjetas (reemplaza al selector de variantes) {%- endcomment -%}\n{%- unless product.has_only_default_variant -%}\n<style>\n  .ch-packs { border:0; margin:0; padding:0; }\n  .ch-packs__legend { display:block; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--color-scheme-text); opacity:.85; margin-bottom:8px; }\n  .ch-packs__list { display:grid; gap:10px; }\n  .ch-packs__item { position:relative; }\n  .ch-packs__card { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-radius:14px; cursor:pointer; background:var(--color-scheme-accent-2); color:var(--color-scheme-accent-2-contrast); border:2px solid transparent; transition:transform .15s, background .15s; }\n  .ch-packs__item input:checked + .ch-packs__card { background:#ff8402; color:#fff; border-color:#fff; box-shadow:0 4px 0 0 rgba(0,0,0,.25); transform:translateY(-2px); }\n  .ch-packs__item input:focus-visible + .ch-packs__card { outline:3px solid #fff; outline-offset:2px; }\n  .ch-packs__title { display:block; font-size:18px; line-height:1.1; }\n  .ch-packs__meta { display:block; font-size:13px; opacity:.8; margin-top:4px; }\n  .ch-packs__price { text-align:right; white-space:nowrap; }\n  .ch-packs__now { font-size:18px; }\n  .ch-packs__badge { position:absolute; top:-10px; right:12px; z-index:1; font-size:11px; letter-spacing:.04em; text-transform:uppercase; padding:3px 10px; border-radius:999px; background:#fff; color:#3b2378; box-shadow:0 1px 3px rgba(0,0,0,.25); }\n  .ch-packs__item--soldout .ch-packs__card { opacity:.45; text-decoration:line-through; }\n  .ch-packs__free { font-weight:700; opacity:1; }\n  .ch-packs__fallback { width:100%; }\n</style>\n{%- if product.options.size == 1 -%}\n  {%- assign option = product.options_with_values[0] -%}\n  {%- assign popular_index = 2 -%}{%- comment -%} 0 = primera opción; 2 = tercera (20 piezas) {%- endcomment -%}\n  {%- assign free_shipping_from = 79900 -%}{%- comment -%} en centavos: $799 {%- endcomment -%}\n  {%- assign base_variant = product.variants.first -%}\n  {%- assign base_units = base_variant.title | split: ' ' | first | plus: 0 -%}\n  {%- assign base_unit_price = 0 -%}\n  {%- if base_units > 0 -%}\n    {%- assign base_unit_price = base_variant.price | times: 1.0 | divided_by: base_units -%}\n  {%- endif -%}\n  <fieldset class=\"ch-packs product-variant-picker-block js-enabled\">\n    <legend class=\"ch-packs__legend font-heading\">Elige tu pack</legend>\n    <div class=\"ch-packs__list\">\n      {%- for value in option.values -%}\n        {%- assign variant = product.variants[forloop.index0] -%}\n        {%- assign units = value | split: ' ' | first | plus: 0 -%}\n        {%- assign saving = 0 -%}\n        {%- assign unit_price = 0 -%}\n        {%- if units > 0 and base_unit_price > 0 -%}\n          {%- assign unit_price = variant.price | times: 1.0 | divided_by: units -%}\n          {%- assign ratio = unit_price | times: 100 | divided_by: base_unit_price | round -%}\n          {%- assign saving = 100 | minus: ratio -%}\n        {%- endif -%}\n        {%- assign badge = '' -%}\n        {%- if forloop.index0 == popular_index -%}\n          {%- assign badge = 'Más popular' -%}\n        {%- endif -%}\n        <div class=\"ch-packs__item variant-input {% unless variant.available %}ch-packs__item--soldout{% endunless %}\">\n          {%- if badge != '' -%}<span class=\"ch-packs__badge font-heading\">{{ badge }}</span>{%- endif -%}\n          <input\n            class=\"custom-button peer absolute left-0 top-0 h-full w-full cursor-pointer opacity-0\"\n            @change=\"optionChange\"\n            type=\"radio\"\n            id=\"Section-{{ section.id }}-Option{{ option.position }}-{{ value | escape }}\"\n            name=\"Section-{{ section.id }}-options[{{ option.name }}]\"\n            value=\"{{ value | escape }}\"\n            data-handle=\"{{ value | handleize }}\"\n            {% if option.selected_value == value %}checked{% endif %}\n            data-single-option-selector\n            data-position=\"{{ option.position }}\"\n          >\n          <label\n            class=\"ch-packs__card\"\n            for=\"Section-{{ section.id }}-Option{{ option.position }}-{{ value | escape }}\"\n          >\n            <span>\n              <span class=\"ch-packs__title font-heading\">{{ value }}</span>\n              <span class=\"ch-packs__meta\">\n                {%- if unit_price > 0 -%}{{ unit_price | round | money }} por pieza{%- endif -%}\n                {%- if variant.price >= free_shipping_from -%}<span class=\"ch-packs__free\"> · Envío gratis</span>{%- endif -%}\n                {%- unless variant.available -%}Agotado{%- endunless -%}\n              </span>\n            </span>\n            <span class=\"ch-packs__price\">\n              <span class=\"ch-packs__now font-heading\">{{ variant.price | money }}</span>\n            </span>\n          </label>\n        </div>\n      {%- endfor -%}\n    </div>\n  </fieldset>\n{%- else -%}\n  {%- comment -%} Productos con más de una opción: selector simple {%- endcomment -%}\n  {%- for option in product.options_with_values -%}\n    <div class=\"my-1\">\n      <label class=\"ch-packs__legend\" for=\"Option{{ option.position }}-{{ section.id }}\">{{ option.name }}</label>\n      <select id=\"Option{{ option.position }}-{{ section.id }}\" name=\"options[{{ option.name | escape }}]\" @change=\"optionChange\" class=\"single-option-selector font-body input ch-packs__fallback\" data-single-option-selector data-position=\"{{ option.position }}\">\n        {%- for value in option.values -%}\n          <option value=\"{{ value | escape }}\" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>\n        {%- endfor -%}\n      </select>\n    </div>\n  {%- endfor -%}\n{%- endif -%}\n{%- endunless -%}\n"
          }
        }
